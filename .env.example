# ===============================
# Base de datos PostgreSQL
# ===============================
# Usadas por docker-compose.yml para crear la BD automáticamente
# Si ejecutas el backend localmente (sin docker), también las usa application.properties

DB_NAME=galeno_clinica
DB_USER=postgres
DB_PASSWORD=tu_password_postgres

# ===============================
# Seguridad JWT RS256 (Sprint 1)
# ===============================
# Clave pública para validar tokens del AuthService de InToGlobe
# En desarrollo: generar con openssl
#   openssl genrsa -out test-private.pem 2048
#   openssl rsa -in test-private.pem -pubout -out test-public.pem
# Copiar el contenido de test-public.pem aquí (con saltos de línea como \n)

AUTH_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----


# ===============================
# Microservicios InToGlobe (WireMock local)
# ===============================

# AUTH_SERVICE_URL: (migración JWT)
AUTH_SERVICE_URL=http://localhost:4001

# NOTIF_SERVICE_URL: (NotifClient + recordatorios WhatsApp)
NOTIF_SERVICE_URL=http://localhost:4002

# STORAGE_SERVICE_URL: (StorageClient + adjuntos)
STORAGE_SERVICE_URL=http://localhost:4003

# PAYMENT_SERVICE_URL: (PaymentClient + suscripciones)
PAYMENT_SERVICE_URL=http://localhost:4004

# AUDIT_SERVICE_URL: (AuditClient fire-and-forget)
AUDIT_SERVICE_URL=http://localhost:4005