# Variables para conectarse al Backend
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_NAME=galeno

# Mocks de datos clínicos: fail-closed (GAL-Front001 §2, guardarraíl 3).
# Requisito doble: solo se activan con `import.meta.env.DEV` (servidor `pnpm dev`) Y esta
# variable definida exactamente como 'true'. Si no está definida (o vale 'false') la
# aplicación habla con la red real: un despliegue mal configurado falla limpio en vez de
# fabricar datos clínicos o aceptar inicios de sesión falsos.
# En un build de producción los mocks nunca se activan, aunque esta variable valga 'true'.
VITE_USE_MOCKS=true